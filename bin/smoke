#!/usr/bin/env ruby
# frozen_string_literal: true

# End-to-end smoke test: boots the real Puma server and drives it exactly like an MCP
# client over Streamable HTTP — POST initialize, notifications/initialized, tools/list and
# a compute_net_pay tools/call to /mcp. Asserts 7 tools and a net_pay figure. Exit 0 = PASS.
#
# rack-test covers the same exchange in-process (spec/mcp_mount_spec.rb); this proves it
# against a booted server with the production middleware stack.
#
#   bin/smoke   # boots on port 9310, ~3s

require "net/http"
require "json"

PORT = 9310
HOST = "127.0.0.1"
ROOT = File.expand_path("..", __dir__)
LOG = File.join(ROOT, "tmp", "smoke.log")

def health_ok?
  Net::HTTP.get_response(URI("http://#{HOST}:#{PORT}/health")).code == "200"
rescue StandardError
  false
end

def post(payload)
  req = Net::HTTP::Post.new("/mcp", "Content-Type" => "application/json",
                                    "Accept" => "application/json, text/event-stream")
  req.body = JSON.generate(payload)
  Net::HTTP.new(HOST, PORT).request(req)
end

# The server answers in JSON mode, but a client must accept either shape, so the smoke
# test does too: a stateful or SSE-mode server would reply with `data:` lines instead.
def parse(resp)
  if resp["content-type"].to_s.start_with?("text/event-stream")
    resp.body.each_line.filter_map { |l| JSON.parse(l.delete_prefix("data:").strip) if l.start_with?("data:") }.last
  else
    JSON.parse(resp.body)
  end
end

def rpc(id, method, params = {})
  parse(post(jsonrpc: "2.0", id: id, method: method, params: params))
end

Dir.mkdir(File.dirname(LOG)) unless Dir.exist?(File.dirname(LOG))
pid = Process.spawn(
  { "RACK_ENV" => "production" },
  "bundle", "exec", "puma", "-p", PORT.to_s, "-e", "production",
  chdir: ROOT, out: LOG, err: LOG
)

begin
  deadline = Time.now + 20
  sleep 0.3 until health_ok? || Time.now > deadline
  raise "server did not become healthy (see #{LOG})" unless health_ok?

  init = rpc(0, "initialize",
             protocolVersion: "2025-06-18", capabilities: {}, clientInfo: { name: "smoke", version: "1" })
  notified = post(jsonrpc: "2.0", method: "notifications/initialized")
  tools = rpc(1, "tools/list").dig("result", "tools") || []
  call = rpc(2, "tools/call",
             name: "compute_net_pay", arguments: { gross_monthly_salary: 30_000, member_type: "employed" })
  text = call.dig("result", "content", 0, "text")
  netpay = text ? JSON.parse(text) : {}

  puts "initialize      : #{init.dig('result', 'serverInfo').values.join(' ')} " \
       "(protocol #{init.dig('result', 'protocolVersion')})"
  puts "initialized     : HTTP #{notified.code}"
  puts "tools/list      : #{tools.length} tools (#{tools.map { |t| t['name'] }.join(', ')})"
  puts "compute_net_pay : net_pay=#{netpay['net_pay']}, sources=#{(netpay['sources'] || {}).keys.join('/')}"

  ok = notified.code.start_with?("2") && tools.length == 7 && netpay["net_pay"]
  puts(ok ? "\nSMOKE PASS ✅" : "\nSMOKE FAIL ❌")
  exit(ok ? 0 : 1)
ensure
  begin
    Process.kill("TERM", pid)
    Process.wait(pid)
  rescue Errno::ESRCH, Errno::ECHILD
    # already gone
  end
end
