#!/usr/bin/env ruby
# frozen_string_literal: true

# Regenerates examples/: one request + response per tool, captured from the real app
# stack in config.ru, plus a human-readable payslip. Run it after any rate-table PR so
# the examples carry the citations and figures the server actually returns.
#
#   bin/capture_examples
#
# In-process (Rack::MockRequest) rather than a booted Puma: same middleware, same bytes
# on the wire, and nothing to wait for. bin/smoke is the booted-server check.

require "json"
require "rack"
require "rack/mock"

ROOT = File.expand_path("..", __dir__)
OUT = File.join(ROOT, "examples")

built = Rack::Builder.parse_file(File.join(ROOT, "config.ru"))
APP = built.is_a?(Array) ? built.first : built

EXAMPLES = {
  "compute_sss_contribution" => { monthly_salary: 25_000, member_type: "employed" },
  "compute_philhealth_contribution" => { monthly_salary: 30_000 },
  "compute_pagibig_contribution" => { monthly_salary: 30_000 },
  "compute_withholding_tax" => { monthly_taxable_income: 30_000 },
  "compute_13th_month_pay" => { total_basic_salary_earned_this_year: 1_200_000, months_worked: 12 },
  "compute_net_pay" => { gross_monthly_salary: 30_000, member_type: "employed" },
  "get_contribution_table" => { table: "sss", as_of: "2026-06-01" }
}.freeze

def tools_call(id, name, arguments)
  request = { jsonrpc: "2.0", id: id, method: "tools/call", params: { name: name, arguments: arguments } }
  response = Rack::MockRequest.new(APP).post(
    "/mcp", input: JSON.generate(request),
            "CONTENT_TYPE" => "application/json", "HTTP_ACCEPT" => "application/json, text/event-stream"
  )
  raise "#{name}: HTTP #{response.status}" unless response.status == 200

  [request, JSON.parse(response.body)]
end

def peso(amount)
  whole, cents = format("%.2f", amount).split(".")
  "₱#{whole.reverse.scan(/\d{1,3}/).join(',').reverse}.#{cents}"
end

Dir.mkdir(OUT) unless Dir.exist?(OUT)

payloads = EXAMPLES.each_with_index.to_h do |(name, arguments), i|
  request, response = tools_call(i + 1, name, arguments)
  raise "#{name}: tool error #{response.dig('result', 'content', 0, 'text')}" if response.dig("result", "isError")

  payload = JSON.parse(response.dig("result", "content", 0, "text"))
  File.write(File.join(OUT, "#{name}.json"), "#{JSON.pretty_generate(
    tool: name,
    effective_date: payload["effective_date"] || payload.dig("sources", "sss", "effective_date"),
    request: request,
    response: response,
    decoded_result: payload
  )}\n")
  [name, payload]
end

slip = payloads.fetch("compute_net_pay")
rows = [
  ["Gross monthly salary", slip["gross"]],
  ["SSS (employee share)", -slip["sss_employee"]],
  ["PhilHealth (employee share)", -slip["philhealth_employee"]],
  ["Pag-IBIG (employee share)", -slip["pagibig_employee"]],
  ["Taxable income", slip["taxable_income"]],
  ["Withholding tax", -slip["withholding_tax"]],
  ["Other deductions", -slip["other_deductions"]],
  ["Total deductions", slip["total_deductions"]],
  ["**Net pay**", slip["net_pay"]]
]
table = rows.map { |label, amount| "| #{label} | #{amount.negative? ? "−#{peso(-amount)}" : peso(amount)} |" }
sources = slip["sources"].map { |agency, s| "- **#{agency}** (effective #{s['effective_date']}): #{s['source_circular']}" }

File.write(File.join(OUT, "payslip-30k-employed.md"), <<~MD)
  # Payslip: ₱30,000 monthly, employed

  Generated by `bin/capture_examples` from `compute_net_pay`
  (`{"gross_monthly_salary": 30000, "member_type": "employed"}`). Rate tables effective
  #{slip.dig('sources', 'sss', 'effective_date')}. The raw request and response are in
  [compute_net_pay.json](compute_net_pay.json).

  | Line | Amount |
  |---|---:|
  #{table.join("\n")}

  Withholding tax is computed on taxable income (gross less the three employee
  contributions).

  ## Sources

  #{sources.join("\n")}

  Informational only, not payroll or tax advice. See the README disclaimer.
MD

puts "Wrote #{payloads.length} tool examples + payslip to examples/"
